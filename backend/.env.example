# Server Port (Render sets this automatically)
PORT=5000

# Client Frontend URL for CORS (Set this to your Vercel URL in Render)
CLIENT_URL=https://syncspace-realtime-collaboration-beta.vercel.app

# Environment Mode
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/syncspace?retryWrites=true&w=majority

# JWT Secret Key for Session Authentication
JWT_SECRET=your_production_jwt_secret_key_change_this

# Token Expiration
JWT_EXPIRES_IN=7d

# OpenAI Integration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
